{
  "name": "@polycode/cli",
  "version": "0.1.0-alpha.0",
  "description": "polycode — a multi-model terminal coding agent (OpenAI, Gemini, xAI).",
  "type": "module",
  "bin": { "poly": "./dist/index.js" },
  "main": "./dist/index.js",
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "@ai-sdk/xai": "^2.0.0",
    "ai": "^5.0.0",
    "ink": "^5.1.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.1.0"
  },
