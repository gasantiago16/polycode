{
  "name": "polycode",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx packages/cli/src/index.ts",
    "serve": "tsx packages/cli/src/index.ts --serve",
    "smoke": "tsx scripts/smoke.ts",
    "route-check": "tsx scripts/route-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "docs": "tsx scripts/build-docs.ts",
    "build": "tsup --config packages/cli/tsup.config.ts"
  },
  "devDependencies": {
    "@polycode/core": "workspace:*",
    "@polycode/providers": "workspace:*",
    "@polycode/router": "workspace:*",
    "@polycode/sandbox": "workspace:*",
    "@polycode/secrets": "workspace:*",
    "@polycode/tools": "workspace:*",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@vitest/coverage-v8": "3.2.4",
    "marked": "^14.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@napi-rs/keyring"]
  }
}
